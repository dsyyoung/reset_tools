# Backend PostgreSQL connection. Set these in Lambda environment variables,
# or add them to the existing ignored .env for local development.
PGHOST=your-database-host
PGPORT=5432
PGDATABASE=reset_clinical_test
PGUSER=your-read-only-database-user
PGPASSWORD=replace-locally-do-not-commit
# Optional: path to a trusted CA bundle, readable by the backend.
# PGSSLROOTCERT=/var/task/postgres-ca.pem
